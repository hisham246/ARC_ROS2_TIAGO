Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: torso_lift_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: Target (VR, raw)
      Enabled: true
      Topic:
        Value: /vr_cartesian/debug/target
        Depth: 5
        Reliability Policy: Best Effort
      Color: 255; 50; 50
      Shape: Axes
      Axes Length: 0.12
      Axes Radius: 0.01
    - Class: rviz_default_plugins/Pose
      Name: Command (sent)
      Enabled: true
      Topic:
        Value: /vr_cartesian/debug/command
        Depth: 5
        Reliability Policy: Best Effort
      Shape: Axes
      Axes Length: 0.1
      Axes Radius: 0.007
    - Class: rviz_default_plugins/MarkerArray
      Name: Trails and limit box
      Enabled: true
      Topic:
        Value: /vr_cartesian/debug/trails
        Depth: 5
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Focal Point:
        X: 0.4
        Y: -0.2
        Z: 0.0
      Pitch: 0.5
      Yaw: 2.6
