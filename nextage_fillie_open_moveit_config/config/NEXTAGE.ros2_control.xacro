<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="NEXTAGE_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="RARM_JOINT0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RARM_JOINT1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RARM_JOINT2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RARM_JOINT3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RARM_JOINT4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="RARM_JOINT5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['RARM_JOINT5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="LARM_JOINT5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['LARM_JOINT5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="CHEST_JOINT0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['CHEST_JOINT0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="HEAD_JOINT0">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['HEAD_JOINT0']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="HEAD_JOINT1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['HEAD_JOINT1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
